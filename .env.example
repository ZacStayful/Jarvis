# ─── JARVIS Environment Variables ────────────────────────────────────────────
# Copy this to .env.local for local dev.
# Add all variables to Vercel > Project Settings > Environment Variables for production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Monday.com ────────────────────────────────────────────────────────────────
# Get from: Monday.com > Profile > Admin > API
MONDAY_API_KEY=your_monday_api_key_here

# ── Google (Drive + Gmail + Calendar share one OAuth access token) ─────────────
# Get from: Google Cloud Console > OAuth 2.0 > Generate access token
# Scopes needed:
#   https://www.googleapis.com/auth/drive
#   https://www.googleapis.com/auth/gmail.modify
#   https://www.googleapis.com/auth/calendar
# Note: Access tokens expire. For production, implement OAuth refresh flow.
GOOGLE_ACCESS_TOKEN=your_google_oauth_access_token_here

# ── Slack ──────────────────────────────────────────────────────────────────────
# Get from: api.slack.com > Your Apps > OAuth & Permissions > Bot Token (xoxb-...)
# Scopes needed: channels:read, channels:history, chat:write, files:read
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# ── Calendly ──────────────────────────────────────────────────────────────────
# Get from: Calendly > Account Settings > Integrations > API & Webhooks > Personal Access Token
CALENDLY_API_KEY=your_calendly_personal_access_token_here

# ── Granola ───────────────────────────────────────────────────────────────────
# Get from: Granola app settings > API access
GRANOLA_API_KEY=your_granola_api_key_here

# ── NewsAPI (Phase 5 intelligence briefing) ─────────────────────────────────
# Get from: https://newsapi.org (free tier = 100 req/day; localhost-only)
# Production: upgrade to Developer plan for 500 req/day + Vercel use
NEWSAPI_KEY=

# ── AssemblyAI (voice transcription) ──────────────────────────────────────────
ASSEMBLYAI_API_KEY=4610edab175d4b29a43ac9d60dee2cd9

# ── ElevenLabs (voice output) ────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Auth (password protection) ───────────────────────────────────────────────
JARVIS_PASSWORD=your_jarvis_access_password_here

# ── Session signing secret (cookie auth) ─────────────────────────────────────
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
